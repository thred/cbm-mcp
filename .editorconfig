# Editor configuration, see https://editorconfig.org
root = true

[*]
indent_style = space
indent_size = 4
tab_width = 4
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 120

[*.yml]
indent_size = 2

[*.ts]
quote_type = double
ij_typescript_use_double_quotes = true

[*.md]
max_line_length = off
trim_trailing_whitespace = false
